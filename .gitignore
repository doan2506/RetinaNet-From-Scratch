# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyTorch checkpoints and model weights
*.pth
*.pt
*.ckpt
models/best.pth
models/*.pth
checkpoints/

# Prediction outputs and scores
predictions.json
val_predictions.json
val_score.json
